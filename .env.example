# Copiá a `.env` y completá valores. No subas `.env` al repositorio.

DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require"

JWT_SECRET="mínimo-32-caracteres-en-producción"

# Orígenes del front (coma separados). En Cloud Run, si definís esta variable, el backend también
# permite automáticamente localhost / 127.0.0.1 en los puertos típicos de Expo Web (8081, 8082, 19006).
# Ejemplo producción + previews:
# CORS_ORIGINS=https://tu-app.vercel.app,https://preview-xxx.vercel.app
CORS_ORIGINS=

# Opcional: Cloudinary para logos de empresa (perfil)
# CLOUDINARY_URL=

# Recuperación de contraseña (Resend). Obligatorios para POST /auth/solicitar-reset.
# API key: https://resend.com/api-keys — «From»: remitente verificado en Resend (dominio propio o onboarding@resend.dev en pruebas).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# URL pública del front web para enlaces del correo (sin barra final).
PUBLIC_WEB_URL=http://localhost:8081

# Deep link de la app (debe coincidir con scheme en app.json del frontend Expo).
APP_LINK_SCHEME=tikbal
